node_modules/
.DS_Store
*.log

# The .env and any copy of it. The pattern is broad on purpose: a bare `.env`
# does not cover a `.env.bak` made in passing before editing it, and that file
# carries the same credentials in a repository that is published whole.
# .env.example is committed: it has no values, only each variable's comment.
.env
.env.*
!.env.example

# 3D sources. The .blend files and uncompressed .glb files stay on disk but
# not in the repository: they are never served, they weigh hundreds of MB and
# GitHub Pages publishes everything committed. See README, "Fuentes de los
# modelos 3D".
*.blend
*.blend1
imgs/assets/3d-visuals/**/src/

# Working notes, with workshop details that have no reason to be published.
LAUNCH-CHECKLIST.md

# seeded design canvas (rebuild with the design skill)
design/*.html
!design/*.dc.html

# The Sherwin-Williams colour database. The bundle's 400 MB of CSV and the
# ~110 MB of export built from it: they are the input to server/colordb/, not
# part of the site, and the repository is public. Same rule as the 3D sources
# above. See server/colordb/README.md.
server/colordb/bundle/data/
server/colordb/export/

# Python bytecode caches from the scripts in tools/.
__pycache__/
