node_modules/
.DS_Store
*.log

# El .env y cualquier copia suya. El patrón es amplio a propósito: `.env` a
# secas no cubre un `.env.bak` hecho de paso antes de editarlo, y ese archivo
# lleva las mismas credenciales en un repositorio que se publica entero.
# .env.example sí se versiona: no tiene valores, solo el comentario de cada
# variable.
.env
.env.*
!.env.example

# Fuentes 3D. Los .blend y los .glb sin comprimir se quedan en el disco pero
# no en el repositorio: no se sirven nunca, pesan cientos de MB y GitHub Pages
# publica todo lo versionado. Ver README, "Fuentes de los modelos 3D".
*.blend
*.blend1
imgs/assets/3d-visuals/**/src/

# Notas de trabajo, con datos del taller que no tienen por qué publicarse.
LAUNCH-CHECKLIST.md

# seeded design canvas (rebuild with the design skill)
design/*.html
!design/*.dc.html

# The Sherwin-Williams colour database. The bundle's 400 MB of CSV and the
# ~110 MB of export built from it: they are the input to server/colordb/, not
# part of the site, and the repository is public. Same rule as the 3D sources
# above. See server/colordb/README.md.
server/colordb/bundle/data/
server/colordb/export/
