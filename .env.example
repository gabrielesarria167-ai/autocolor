# Copy this file to .env and fill in the values. The .env is in .gitignore
# and stays on the machine: that matters more than usual, because this
# repository is published whole on GitHub Pages and a committed secret would
# be in plain view.
#
#     cp .env.example .env
#
# Whatever the environment already has wins over this file.

# Workshop panel password (pgs/taller.html). It is the only one there is and
# everyone working at the shop shares it. Without this line the panel answers
# 503 and nobody can log in: off rather than open.
AUTOCOLOR_STAFF_PASSWORD=cambia-esta-contrasena

# The panel's workers: comma-separated entries, each one a code, a colon and
# the name of the person it belongs to. The code is the first initial + the
# surname initial + 5 digits (AB12345); the name is what the panel shows in
# place of the code, and can be left off, in which case the code is shown.
# Needed alongside the password: without this line the panel answers 503, same
# as without a password. Hand one code to each person at the shop.
AUTOCOLOR_WORKER_IDS=AB12345:Ana Bravo,CD67890:Carlos Díaz

# The workshop boss: one entry, written exactly like the ones above. No need to
# repeat it on the previous line: it is accepted on its own. His profile is
# different: instead of the start-session button it carries the monitor, which
# shows which vehicle each worker is holding, and in exchange he takes no
# vehicles and changes no statuses. This line is optional: without it there is
# no boss, nobody sees the monitor, and the panel works as it always did.
AUTOCOLOR_BOSS_ID=EF13579:Elena Flores

# --- The emails for each new request (server/mail.js) ------------------------
#
# The Brevo API key, which is how the two notices for each request go out.
# Without it no email is sent and the wizard works the same: that is the
# normal case on this machine.
#
# Get it in Brevo > SMTP & API > API keys. It is the only secret needed: there
# is no user or password.
#
# THIS USED TO BE GMAIL'S SMTP AND IT DID NOT WORK from Render: connections to
# smtp.gmail.com timed out with no answer, on 465 and on 587 too. See the
# header of server/mail.js.
# AUTOCOLOR_BREVO_KEY=PEGA-AQUI-LA-LLAVE-DE-BREVO

# The sender. Defaults to the same AUTOCOLOR_MAIL_SHOP below.
#
# THE ADDRESS HAS TO BE VERIFIED IN BREVO (Brevo > Senders), or the API
# answers 400 and sends nothing. Verifying means receiving an email and
# clicking a link, so it has to be one that can be opened. The display name
# is free.
# AUTOCOLOR_MAIL_FROM=CUENTA-DEL-TALLER@gmail.com
# AUTOCOLOR_MAIL_FROM_NAME=Autocolor

# Where the copy with the customer's details goes.
# AUTOCOLOR_MAIL_SHOP=CUENTA-DEL-TALLER@gmail.com

# The site's public address, for the links in the emails. On a host like
# Render it is not needed: RENDER_EXTERNAL_URL already carries it. With
# neither, the emails go out without links rather than with an
# http://localhost that helps nobody.
# AUTOCOLOR_SITE_URL=https://autocolor.onrender.com

# Daily ceilings on outgoing mail, against abuse of the public form (see
# "Daily caps" in the README). Brevo's free plan sends 300 a day.
# AUTOCOLOR_MAIL_DAILY_CAP=280
# AUTOCOLOR_MAIL_CUSTOMER_DAILY_CAP=120

# Set to 1 once the panel sits behind https, so the session cookie travels as
# Secure. On http://localhost it has to stay off: the browser would drop the
# cookie and nobody could log in.
# AUTOCOLOR_STAFF_COOKIE_SECURE=0

# The server's port and the address it listens on. 127.0.0.1 (the default)
# keeps it on this machine only; 0.0.0.0 opens it to the shop's network, which
# is needed to test from a phone and exposes the work queue to whoever is
# connected. On a host 0.0.0.0 is required, and the host provides the port.
# PORT=3000
# HOST=127.0.0.1

# The database, when it lives on a hosted service and not on this machine.
# When set, it rules entirely and the PG* variables below are ignored. It goes
# in the host's dashboard, not here: this file is an example and the real
# .env stays on the machine.
#
# Careful with the URL they give you to copy: write 'sslmode=verify-full' by
# hand. 'sslmode=require' means the same today, but pg prints a deprecation
# warning and in pg 9 it will check less. pg ignores 'channel_binding', so it
# is not needed.
# DATABASE_URL=postgresql://usuario:clave@servidor/base?sslmode=verify-full

# ---------------------------------------------------------------------------
# The colour database
#
# It is ANOTHER database: the Sherwin-Williams catalogue the matizado page
# uses to identify colours. Read-only, and the role below cannot read any
# table: it can only run six functions. See server/colordb/README.md.
#
# Three differences from DATABASE_URL worth keeping in mind:
#
# 1. The 'sslmode=verify-full' here IS CHECKED at startup. If it is missing,
#    or says 'require', the server does not connect and says so in the log.
#    Above it is a recommendation in a comment; here it is a condition.
# 2. The role is NOT the one Neon creates with the project. colordb_app is
#    created with SQL (server/colordb/sql/80_neon_grants.sql), never from the
#    Neon console: a role created there gets neon_superuser, which reads every
#    table and makes everything else pointless.
# 3. If it is missing, the site works the same. The colour finder answers 503
#    and the page falls back to the local catalogue of 777 colours. Nothing
#    else switches off.
# AUTOCOLOR_COLORDB_URL=postgresql://colordb_app:clave@servidor/colordb?sslmode=verify-full

# Simultaneous connections to the colour database. Defaults to 4: the
# requests database already takes 10 of the Neon budget, and requests are the
# ones that cannot wait.
# AUTOCOLOR_COLORDB_MAX=4

# Switches the colour finder off without touching the URL. Useful when Neon
# goes over quota and the rest of the site has to keep running.
# AUTOCOLOR_COLORDB_DISABLED=1

# The finder's two daily ceilings, in case they need adjusting. The first is
# per address, the second for the whole process: past the second, the finder
# answers 503 and says so once in the log. They exist so that copying the
# whole catalogue is expensive and, above all, visible.
# AUTOCOLOR_COLORDB_DAILY_IP=2000
# AUTOCOLOR_COLORDB_DAILY_TOTAL=60000

# The colour database's owner role, the one that creates the tables and loads
# the rows. ONLY for server/colordb/push.sh, from the work machine. It does
# NOT go in the host's dashboard: the server has nothing to do with it.
# AUTOCOLOR_COLORDB_ADMIN_URL=postgresql://dueño:clave@servidor/colordb?sslmode=verify-full
# AUTOCOLOR_COLORDB_APP_PASSWORD=la-que-se-le-pone-a-colordb_app

# How many trusted proxies sit in front of the process. 0 (the default) is
# this machine, with nothing in between. 1 is normal behind a host or your own
# nginx.
#
# It is not a detail: without it, behind a proxy every request appears to come
# from the same address, and the per-IP limits merge into one. Five wrong
# passwords from any visitor and the workshop cannot log in.
# TRUST_PROXY=1

# Origins that may call the API from another domain, comma-separated. Only
# needed if the site is published separately from the API.
# ALLOWED_ORIGINS=https://gabrielesarria167-ai.github.io
