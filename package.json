{
  "name": "autocolor",
  "version": "1.0.0",
  "private": true,
  "description": "Autocolor — sitio y asistente de cotización de pintura automotriz",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "db:init": "./server/pgserver.sh init",
    "db:start": "./server/pgserver.sh start",
    "db:stop": "./server/pgserver.sh stop",
    "db:status": "./server/pgserver.sh status",
    "db:psql": "./server/pgserver.sh psql",
    "db:schema": "./server/pgserver.sh schema",
    "db:migrate": "node server/migrate.js",
    "colordb:load": "./server/colordb/load.sh",
    "colordb:push": "./server/colordb/push.sh",
    "colordb:verify": "node server/colordb/verify.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
